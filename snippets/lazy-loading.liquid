{% doc %}
  Applies the global skeleton and blur-up loading state to storefront images.
{% enddoc %}

<script>
  (() => {
    const imageStates = new WeakMap();
    const transitionDuration = 800;

    const getSourceKey = (image) =>
      [
        image.getAttribute('src'),
        image.getAttribute('srcset'),
        image.getAttribute('sizes'),
        image.dataset.src,
        image.dataset.srcset,
        image.currentSrc
      ].filter(Boolean).join('|');

    const finishImage = (image, token) => {
      if (imageStates.get(image) !== token) return;

      const reveal = () => {
        if (imageStates.get(image) !== token) return;

        image.dataset.globalImageLoaded = 'true';
        image.classList.add('global-image-loaded');

        window.setTimeout(() => {
          if (imageStates.get(image) !== token) return;
          image.classList.remove('global-image-loaded');
        }, transitionDuration);
      };

      if (typeof image.decode === 'function') {
        image.decode().catch(() => {}).finally(() => window.requestAnimationFrame(reveal));
      } else {
        window.requestAnimationFrame(reveal);
      }
    };

    const failImage = (image, token) => {
      if (imageStates.get(image) !== token) return;
      image.dataset.globalImageLoaded = 'error';
      image.classList.remove('global-image-loaded');
    };

    const watchImage = (image) => {
      if (!(image instanceof HTMLImageElement) || image.hasAttribute('data-image-loader-ignore')) return;

      const sourceKey = getSourceKey(image);
      if (!sourceKey) return;

      const currentState = imageStates.get(image);
      if (currentState?.sourceKey === sourceKey && image.dataset.globalImageLoaded) return;

      const token = { sourceKey };
      imageStates.set(image, token);
      image.removeAttribute('data-global-image-loaded');
      image.classList.remove('global-image-loaded');

      if (image.complete) {
        if (image.naturalWidth > 0) {
          finishImage(image, token);
        } else {
          failImage(image, token);
        }
        return;
      }

      image.addEventListener('load', () => finishImage(image, token), { once: true });
      image.addEventListener('error', () => failImage(image, token), { once: true });
    };

    const lazyImageObserver = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const image = entry.target;
            if (image.dataset.srcset) image.srcset = image.dataset.srcset;
            if (image.dataset.src) image.src = image.dataset.src;
            observer.unobserve(image);
            watchImage(image);
          });
        }, { rootMargin: '100px 0px', threshold: 0.01 })
      : null;

    const prepareImage = (image) => {
      if (!(image instanceof HTMLImageElement) || image.hasAttribute('data-image-loader-ignore')) return;

      if ((image.dataset.src || image.dataset.srcset) && !image.currentSrc && !image.getAttribute('src')) {
        if (lazyImageObserver) {
          lazyImageObserver.observe(image);
        } else {
          if (image.dataset.srcset) image.srcset = image.dataset.srcset;
          if (image.dataset.src) image.src = image.dataset.src;
          watchImage(image);
        }
        return;
      }

      watchImage(image);
    };

    const prepareImagesWithin = (node) => {
      if (!(node instanceof Element)) return;
      if (node instanceof HTMLImageElement) prepareImage(node);
      node.querySelectorAll('img').forEach(prepareImage);
    };

    document.querySelectorAll('img').forEach(prepareImage);

    const imageObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes') {
          prepareImage(mutation.target);
          return;
        }

        mutation.addedNodes.forEach(prepareImagesWithin);
      });
    });

    imageObserver.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['src', 'srcset', 'sizes']
    });
  })();
</script>
